# Copie este arquivo para .env.local e preencha com os valores do projeto Supabase
# (Dashboard > Project Settings > API Keys). Nunca versione .env.local.

# URL do projeto Supabase (ex.: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "publishable" (sb_publishable_...). Projetos antigos podem usar
# a chave legada "anon" aqui. NUNCA use a chave secreta / service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_...). Somente servidor: ignora RLS. Nunca use o
# prefixo NEXT_PUBLIC_ nem a importe em Client Components.
SUPABASE_SECRET_KEY=

# "true" exibe o conteúdo provisório (exemplos de layout) em builds de revisão.
# Em `npm run dev` ele já aparece; em produção deve ficar vazio.
SHOW_CONTENT_PLACEHOLDERS=
