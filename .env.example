# Copie este arquivo para .env.local e preencha com os valores do projeto Supabase
# (Dashboard > Project Settings > API Keys). Nunca versione .env.local.

# URL do projeto Supabase (ex.: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "publishable" (sb_publishable_...). Projetos antigos podem usar
# a chave legada "anon" aqui. NUNCA use a chave secreta / service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_...). Somente servidor: ignora RLS. Nunca use o
# prefixo NEXT_PUBLIC_ nem a importe em Client Components.
SUPABASE_SECRET_KEY=

# Opcional: origem pública do site (sem caminho), usada em canonical, Open
# Graph, sitemap.xml, robots.txt e links de e-mail. Sem ela, vale o endereço
# do Worker (https://geologar.plataformageologar.workers.dev). Em produção,
# definir no build do Cloudflare (Workers Builds) quando houver domínio próprio.
# NEXT_PUBLIC_SITE_URL=

# Formulário de contato: as variáveis (Resend, Turnstile, destinatário) são de
# runtime do Worker. NÃO as coloque aqui — o build do OpenNext embute `.env*`
# no Worker. Use `.dev.vars` (modelo em .dev.vars.example) e o painel do
# Cloudflare. Ver docs/contact-form.md.
