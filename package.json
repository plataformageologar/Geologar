{
  "name": "geologar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "node scripts/assert-no-secret-env.mjs && npm run build && opennextjs-cloudflare deploy",
    "upload": "node scripts/assert-no-secret-env.mjs && npm run build && opennextjs-cloudflare upload",
    "db:types": "supabase gen types --lang=typescript --schema public --remote > src/types/database.types.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.157.0"
  }
}
